// Разрешает пользователю @USER@ включать и выключать туннель без пароля.
// Действует только на одну службу: awg-quick@@IFACE@.service
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "awg-quick@@IFACE@.service" &&
        subject.user == "@USER@") {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart") {
            return polkit.Result.YES;
        }
    }
});
